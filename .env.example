# --- Required: Bedrock Mantle API key ---
# NOTE: the SDK used here is OpenAI-compatible, so the code reads this key
# from OPENAI_API_KEY — but it authenticates against Bedrock Mantle only.
# This project does not call the OpenAI API directly.
OPENAI_API_KEY=your-mantle-api-key-here

# --- Bedrock Mantle endpoint ---
MANTLE_BASE_URL=https://bedrock-mantle.ap-south-1.api.aws/v1

# --- Optional: only needed if the MultiHop-RAG dataset requires a gated HF download ---
# HF_TOKEN=your-huggingface-token-here

# --- Optional: FastAPI backend CORS allowlist (comma-separated), used by backend/app.py ---
# DEMO_ALLOWED_ORIGINS=http://localhost:3000

# --- Optional: frontend's live-demo API base URL, used by frontend/components/sections/LiveDemo.tsx ---
# NEXT_PUBLIC_DEMO_API_URL=http://localhost:8000
