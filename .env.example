# Environment variables for Adaptive Multi-Hop Retrieval.
# Copy to `.env` and fill in values. Phase 1 (dataset ingestion) reads none of
# these — they are placeholders reserved for later phases.

# --- Amazon Bedrock Mantle (Phase 6 onward) ---
# Mantle exposes an OpenAI-compatible endpoint; the OpenAI Python SDK is
# used directly against it (see mhrag.generation.mantle_client). Model ID
# is a fixed, approved decision in configs/models.yaml / configs/mantle.yaml
# — not env-configurable. NEVER commit a real key to this file or any other
# tracked file; OPENAI_API_KEY is read only from the environment at runtime
# and is never logged, printed, or persisted anywhere in this codebase.
MANTLE_BASE_URL=https://bedrock-mantle.ap-south-1.api.aws/v1
OPENAI_API_KEY=

# --- Qdrant (used from the retrieval-stack phase onward) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Hugging Face (optional; raises the anonymous rate limit for dataset downloads) ---
HF_TOKEN=
